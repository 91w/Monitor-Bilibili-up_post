{
  "Version": "1",
  "Statement": [
    {"Effect":"Deny","Action":["oss:*"],"Resource":["acs:oss:*:*:REPLACE_BUCKET","acs:oss:*:*:REPLACE_BUCKET/*"],"Condition":{"Bool":{"acs:SecureTransport":["false"]}}},
    {"Effect":"Allow","Action":["oss:ListObjects"],"Resource":["acs:oss:*:*:REPLACE_BUCKET"],"Condition":{"StringLike":{"oss:Prefix":["devices/REPLACE_DEVICE/inbox/*"]}}},
    {"Effect":"Allow","Action":["oss:GetObject","oss:DeleteObject"],"Resource":["acs:oss:*:*:REPLACE_BUCKET/devices/REPLACE_DEVICE/inbox/*"]},
    {"Effect":"Allow","Action":["oss:PutObject"],"Resource":["acs:oss:*:*:REPLACE_BUCKET/devices/REPLACE_DEVICE/receipts/*"]}
  ]
}
